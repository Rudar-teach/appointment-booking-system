# Server
PORT=3000
SESSION_SECRET=change_me_to_a_random_string_at_least_32_chars
NODE_ENV=development

# Database
DB_PATH=./data/appointments.db

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email/SMS (optional - for future integration)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=

# Reminder schedule (hours before appointment)
REMINDER_HOURS_BEFORE=24
